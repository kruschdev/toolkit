# @krusch/toolkit & krusch_toolkit — Environment Template
# Copy to .env and customize for your local or production environment.
# Never commit real API keys, database passwords, or private host IPs.

# Local LLM & Embeddings (defaults to 127.0.0.1)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_HOST=http://127.0.0.1:11434
OLLAMA_NODES=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=qwen2.5-coder:7b
OLLAMA_BG_MODEL=qwen3-coder-30b-moe:latest
COLAB_BURST_URL=http://127.0.0.1:11435

# Optional Frontier LLM Providers
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional PostgreSQL / pgvector
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:5432/appdb

# Optional Audio Modality Endpoints (Whisper STT / Kokoro or OpenAI-compatible TTS)
WHISPER_URL=http://127.0.0.1:9000/v1/audio/transcriptions
TTS_URL=http://127.0.0.1:8880/v1/audio/speech
